# Opcional no Railway: o domínio gerado é lido de RAILWAY_PUBLIC_DOMAIN.
# Com domínio próprio, defina a origem pública HTTPS, sem caminho.
# SITE_URL=https://eleicoes2026.seudominio.com.br
PORT=3000
# Configure estas credenciais somente no ambiente privado do servidor.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Em produção, use o volume persistente montado em /data.
# ANALYTICS_DB_PATH=/data/analytics.sqlite
# Apenas atrás do proxy confiável do Railway; não habilitar em um servidor exposto diretamente.
# TRUST_PROXY=1
